{
  "expo": {
    "name": "TexxxNopor",
    "slug": "texxxnopor-mobile",
    "scheme": "texxxnopor",
    "version": "3.6.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.texxxnopor.mobile",
      "buildNumber": "1.4.1",
      "infoPlist": {
        "NSCameraUsageDescription": "TexxxNopor necesita acceso a tu cámara para emitir transmisiones en vivo a tus seguidores.",
        "NSMicrophoneUsageDescription": "TexxxNopor necesita acceso a tu micrófono para transmitir en vivo con audio."
      }
    },
    "android": {
      "package": "com.texxxnopor.mobile",
      "versionCode": 10,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TexxxNopor necesita acceso a tu cámara para emitir transmisiones en vivo a tus seguidores.",
          "microphonePermission": "TexxxNopor necesita acceso a tu micrófono para transmitir en vivo con audio."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e44c541a-3a7a-4b84-92ac-67f212ef48b3"
      }
    }
  }
}